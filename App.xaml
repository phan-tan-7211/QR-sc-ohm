<Application x:Class="UC2836Live.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
  <Style TargetType="TextBlock"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="Background" Value="#DFE9EF"/><Setter Property="Foreground" Value="#142D43"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#B9CBD8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#087E75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E8EDF1"/><Setter Property="Foreground" Value="#546577"/><Setter Property="BorderBrush" Value="#CED8E0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#142D43"/></Style></Style.Resources><Setter Property="Foreground" Value="#142D43"/><Setter Property="Background" Value="White"/><Setter Property="MinWidth" Value="100"/><Setter Property="Margin" Value="0,0,10,4"/><Setter Property="Padding" Value="8,8"/><Setter Property="MinHeight" Value="40"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#142D43"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#DFE9EF"/><Setter Property="Foreground" Value="#142D43"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,12"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#142D43"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C8EAE3"/><Setter Property="Foreground" Value="#102D36"/></Trigger></Style.Triggers></Style>
 </Application.Resources>
</Application>
