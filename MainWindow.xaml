<Window x:Class="UC2836Live.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UC2836Live.Services" local:LocalizationManager.Key="Main.Title" Width="1560" Height="860" MinWidth="1100" MinHeight="720" Background="#EEF3F7" Foreground="#142D43" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
 <Grid Margin="24">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="20"/>
   <ColumnDefinition Width="680"/>
  </Grid.ColumnDefinitions>

  <!-- ========== CỘT TRÁI: nội dung đo ========== -->
  <Grid Grid.Column="0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="UC2836CX+" FontSize="30" FontWeight="Bold"/><TextBlock local:LocalizationManager.Key="Main.Station" Foreground="#435E73" Margin="0,4,0,18"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="Status" local:LocalizationManager.Key="Main.NotConnected" Foreground="#087567" HorizontalAlignment="Right"/><TextBlock x:Name="Identity" Text="USB CDC · SCPI" Foreground="#435E73" Margin="0,8,0,0"/><ComboBox x:Name="LanguageSelector" Width="120" HorizontalAlignment="Right" Margin="0,8,0,0" SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged"><ComboBoxItem Tag="en-US" Content="English"/><ComboBoxItem Tag="vi-VN" Content="Tiếng Việt"/><ComboBoxItem Tag="ko-KR" Content="한국어"/></ComboBox></StackPanel></Grid>
   <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,0,16"><WrapPanel VerticalAlignment="Center">
    <TextBlock local:LocalizationManager.Key="Main.Port" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Port" IsEditable="True" Text="COM3"/>
    <TextBlock local:LocalizationManager.Key="Main.Baud" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Baud" SelectedIndex="0"><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="115200"/></ComboBox>
    <Button x:Name="Refresh" Content="↻" ToolTip="Find ports" Click="Refresh_Click"/>
    <Button x:Name="Start" local:LocalizationManager.Key="Common.Connect" Background="#087E75" Foreground="White" Click="ToggleConnection_Click"/>
    <Button local:LocalizationManager.Key="Common.ExportCsv" Click="Export_Click"/>
    <TextBlock local:LocalizationManager.Key="Main.ReadCycle" VerticalAlignment="Center" Margin="8,0,8,0"/><ComboBox x:Name="Interval" SelectedIndex="1" MinWidth="75"><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="250"/><ComboBoxItem Content="500"/></ComboBox>
   </WrapPanel></Border>
   <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="PrimaryLabel" Text="LA · CUỘN A" Foreground="#435E73"/><TextBlock x:Name="LA" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#087567" Margin="0,8"/><TextBlock local:LocalizationManager.Key="Main.AutomaticUnit" Foreground="#435E73" FontSize="12"/></StackPanel></Border>
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="SecondaryLabel" Text="LB · CUỘN B" Foreground="#435E73"/><TextBlock x:Name="LB" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#175FAC" Margin="0,8"/><TextBlock local:LocalizationManager.Key="Main.AutomaticUnit" Foreground="#435E73" FontSize="12"/></StackPanel></Border>
    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18"><StackPanel><TextBlock x:Name="CLabel" local:LocalizationManager.Key="Main.MeasurementState" Foreground="#435E73"/><TextBlock x:Name="CValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="DcText" local:LocalizationManager.Key="Main.ResultFromDevice" Foreground="#435E73" FontSize="12"/></StackPanel></Border>
   </UniformGrid>
   <!-- QR vẫn nhận được từ camera; các trường ẩn giữ tương thích với máy quét USB và logic cũ. -->
   <StackPanel Visibility="Collapsed"><TextBox x:Name="QrInput" KeyDown="QrInput_KeyDown"/><TextBlock x:Name="QrState" local:LocalizationManager.Key="Main.NotScanned"/></StackPanel>
   <!-- Hai trạng thái vẫn được giữ làm dữ liệu nội bộ để CSV/logic phân loại hoạt động,
        nhưng không chiếm diện tích giao diện. Kết quả xem trong bảng lịch sử. -->
   <StackPanel Visibility="Collapsed"><TextBlock x:Name="Compare"/><TextBlock x:Name="Wire"/></StackPanel>
   <StackPanel Grid.Row="3" Margin="0,0,0,12"><TextBlock x:Name="Settings" local:LocalizationManager.Key="Main.ReadConfig"/><TextBlock x:Name="Second" Text="" Foreground="#435E73" Margin="0,5,0,0"/></StackPanel>
   <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,14"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock local:LocalizationManager.Key="Main.Trend" FontWeight="SemiBold"/><TextBlock x:Name="ChartLegend" Text="LA  ━ xanh ngọc     LB  ━ xanh lam" HorizontalAlignment="Right" Foreground="#435E73"/></DockPanel>
    <Canvas x:Name="Chart" Grid.Row="1" ClipToBounds="True" SizeChanged="Chart_SizeChanged" Margin="0,8" Background="#F5F8FB"><Polyline x:Name="LineA" Stroke="#087567" StrokeThickness="2"/><Polyline x:Name="LineB" Stroke="#175FAC" StrokeThickness="2"/></Canvas>
    <TextBlock x:Name="Scale" Grid.Row="2" local:LocalizationManager.Key="Main.Axis" FontSize="12" Foreground="#435E73"/>
   </Grid></Border>
   <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="Stats" Text="0" Foreground="#435E73"/><TextBlock x:Name="Raw" Visibility="Collapsed" Text="RX" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock x:Name="LogPath" Foreground="#435E73" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  </Grid>

  <!-- ========== CỘT PHẢI: camera QR + lịch sử đo ========== -->
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Tiêu đề -->
    <DockPanel Margin="0,0,0,12">
     <Button DockPanel.Dock="Right" Content="⚙" Click="CamDevSettings_Click" Padding="6,3" FontSize="13" MinHeight="0" ToolTip="Cài đặt thông số dev" Background="#DEEAF1" VerticalAlignment="Top"/>
     <StackPanel>
      <TextBlock local:LocalizationManager.Key="Main.CameraQr" FontWeight="Bold" FontSize="15"/>
      <TextBlock local:LocalizationManager.Key="Main.AutoScan" Foreground="#435E73" FontSize="12" Margin="0,3,0,0"/>
     </StackPanel>
    </DockPanel>

    <!-- Nguồn + nút bật/tắt -->
    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
     <Button x:Name="CamToggle" DockPanel.Dock="Right" Content="On" Click="CamToggle_Click" Background="#087E75" Foreground="White" Padding="10,8" MinHeight="36" Margin="6,0,0,4"/>
     <ComboBox x:Name="CamSources" MinWidth="60" Padding="6,6" MinHeight="36" Margin="0,0,0,4"/>
    </DockPanel>

    <!-- Zoom -->
    <Grid Grid.Row="2" Margin="0,0,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
     <TextBlock local:LocalizationManager.Key="Main.Zoom" VerticalAlignment="Center" FontSize="12"/>
     <Slider x:Name="CamZoom" Grid.Column="1" Minimum="1" Maximum="3" Value="1" SmallChange="0.1" VerticalAlignment="Center" ValueChanged="CamSettings_Changed"/>
     <TextBlock x:Name="CamZoomLabel" Grid.Column="2" Text="1.0×" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right"/>
    </Grid>

    <!-- Checkboxes -->
    <WrapPanel Grid.Row="3" Margin="0,0,0,10">
     <CheckBox x:Name="CamEnhance" local:LocalizationManager.Key="Main.Contrast" IsChecked="False" FontSize="12" Margin="0,0,10,4" Checked="CamSettings_Changed" Unchecked="CamSettings_Changed"/>
     <CheckBox x:Name="CamInvert" local:LocalizationManager.Key="Main.Invert" IsChecked="False" FontSize="12" Margin="0,0,10,4" Checked="CamSettings_Changed" Unchecked="CamSettings_Changed"/>
     <CheckBox x:Name="CamSharpen" local:LocalizationManager.Key="Main.Sharpen" IsChecked="False" FontSize="12" Margin="0,0,0,4" Checked="CamSettings_Changed" Unchecked="CamSettings_Changed"/>
     <CheckBox x:Name="CamShowProcessed" local:LocalizationManager.Key="Main.ShowProcessed" IsChecked="False" FontSize="12" Margin="0,0,0,4" Checked="CamSettings_Changed" Unchecked="CamSettings_Changed"/>
    </WrapPanel>

    <!-- Preview camera -->
    <Border Grid.Row="4" Background="#102030" CornerRadius="8" Height="158" Margin="0,0,0,10">
     <Grid>
      <TextBlock x:Name="CamPlaceholder" local:LocalizationManager.Key="Main.CameraOff" Foreground="#AABBCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
      <Image x:Name="CamPreview" Stretch="Uniform"/>
     </Grid>
    </Border>

    <!-- Mã QR vừa đọc -->
    <StackPanel Grid.Row="5" Margin="0,0,0,8">
     <DockPanel Margin="0,0,0,6">
      <TextBlock local:LocalizationManager.Key="Main.LastQr" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" local:LocalizationManager.Key="Main.ClearScan" Click="CamReset_Click" Padding="8,5" MinHeight="0" FontSize="12" Margin="0,0,0,0"/>
     </DockPanel>
     <Border Background="#F0FAF8" CornerRadius="6" Padding="10,8">
      <TextBlock x:Name="CamQrResult" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#075F59" TextWrapping="Wrap"/>
     </Border>
    </StackPanel>

    <!-- Spacer -->
    <Grid Grid.Row="6"/>

    <!-- Trạng thái camera -->
    <TextBlock x:Name="CamStatus" Grid.Row="7" local:LocalizationManager.Key="Main.CameraOff" Foreground="#435E73" FontSize="12" TextWrapping="Wrap"/>
   </Grid>
  </Border>

  <!-- Lịch sử đo -->
  <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="8">
   <DataGrid x:Name="History" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#FFFFFF" Foreground="#172538" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#EDF4FA" RowHeight="34" GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True">
    <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172538"/></Style></DataGrid.Resources>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="100"/>
     <DataGridTextColumn Header="QR code" Binding="{Binding QrCode}" Width="*"/>
     <DataGridTextColumn Header="Primary / LA" Binding="{Binding DisplayA}" Width="110"/>
     <DataGridTextColumn Header="Secondary / LB" Binding="{Binding DisplayB}" Width="110"/>
     <DataGridTextColumn Header="Result" Binding="{Binding PassFail}" Width="100"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  </Grid>

 </Grid>
</Window>
